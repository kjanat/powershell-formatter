{
	"extends": "https://raw.githubusercontent.com/kjanat/kjanat/master/configs/dprint.remote.json",
	"exec": {
		"commands": [
			{ "command": "tombi format - --stdin-filename {{file_path}}", "exts": ["toml"] },
			{ "command": "just --dump --justfile {{file_path}}", "fileNames": ["justfile"] },
			{ "command": "rustfmt --edition 2024", "exts": ["rs"] },
		],
	},
	"excludes": [
		"target/**",
		// Test fixtures must stay byte-exact: oracle inputs pair with
		// generated expectations, and corpus files intentionally contain
		// unformatted / pathological code.
		"tests/corpus/files/**",
		"tests/powershell-oracle/inputs/**",
		"tests/powershell-oracle/fixtures/**",
		"tests/pssa-parity/inputs/**",
		"tests/pssa-parity/expected/**",
		"fuzz/corpus/**",
		"packages/formatter/dist/**",
	],
	"plugins": [
		"https://plugins.dprint.dev/exec-0.7.3.json@a7898d5f1897e77bff474cec3d948c3ec3a7f455e32de2cc60c8adb9a5dd24aa",
	],
}
