{
	"name": "dprint-plugin-pwsh",
	"version": "0.2.0",
	"description": "PowerShell dprint plugin (plugin.wasm) packaged for @dprint/formatter hosts",
	"keywords": [
		"powershell",
		"pwsh",
		"formatter",
		"dprint",
		"wasm"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kjanat/powershell-formatter.git",
		"directory": "packages/dprint-plugin"
	},
	"license": "MIT",
	"type": "module",
	"imports": {
		"#js": {
			"types": "./index.d.ts",
			"default": "./index.js"
		},
		"#pkg": "./package.json"
	},
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./index.js",
	"types": "./index.d.ts",
	"files": [
		"/index.*",
		"/plugin.wasm"
	],
	"scripts": {
		"build": "run --dir=../.. wasm-plugin",
		"prepack": "run build",
		"pretest": "run build",
		"test": "node --test",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@dprint/formatter": "^0.5.1",
		"@types/node": "^26.2.0",
		"runner-run": "^0.25.1",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=18.19"
	},
	"volta": {
		"extends": "../../package.json"
	}
}
