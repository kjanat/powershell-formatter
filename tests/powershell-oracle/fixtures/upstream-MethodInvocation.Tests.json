ss);\n            return factory.CreateChannel();\n        }\n\n        public static void Close()\n        {\n            serviceHost.Close();\n        }\n    }\n}\n\"@"},{"k":"word","t":"Add-Type"},{"k":"parameter","t":"-TypeDefinition"},{"k":"variable","t":"$src"},{"k":"parameter","t":"-ReferencedAssemblies"},{"k":"word","t":"System.ServiceModel.dll"},{"k":"word","t":"BeforeEach"},{"k":"lcurly","t":"{"},{"k":"lbracket","t":"["},{"k":"word","t":"MSFT_716893.Service"},{"k":"rbracket","t":"]"},{"k":"op","t":"::"},{"k":"word","t":"Init"},{"k":"lparen","t":"("},{"k":"rparen","t":")"},{"k":"variable","t":"$proxy"},{"k":"op","t":"="},{"k":"lbracket","t":"["},{"k":"word","t":"MSFT_716893.Service"},{"k":"rbracket","t":"]"},{"k":"op","t":"::"},{"k":"word","t":"GetProxy"},{"k":"lparen","t":"("},{"k":"rparen","t":")"},{"k":"rcurly","t":"}"},{"k":"word","t":"AfterEach"},{"k":"lcurly","t":"{"},{"k":"lbracket","t":"["},{"k":"word","t":"MSFT_716893.Service"},{"k":"rbracket","t":"]"},{"k":"op","t":"::"},{"k":"word","t":"Close"},{"k":"lparen","t":"("},{"k":"rparen","t":")"},{"k":"rcurly","t":"}"},{"k":"word","t":"It"},{"k":"string2","t":"\"Direct invocation\""},{"k":"lcurly","t":"{"},{"k":"variable","t":"$proxy"},{"k":"op","t":"."},{"k":"word","t":"Operation"},{"k":"lparen","t":"("},{"k":"string2","t":"\"a\""},{"k":"rparen","t":")"},{"k":"pipe","t":"|"},{"k":"word","t":"Should"},{"k":"parameter","t":"-Be"},{"k":"string2","t":"\"1 - a\""},{"k":"variable","t":"$proxy"},{"k":"op","t":"."},{"k":"word","t":"Operation"},{"k":"lparen","t":"("},{"k":"string2","t":"\"a\""},{"k":"comma","t":","},{"k":"string2","t":"\"b\""},{"k":"rparen","t":")"},{"k":"pipe","t":"|"},{"k":"word","t":"Should"},{"k":"parameter","t":"-Be"},{"k":"string2","t":"\"2 - a b\""},{"k":"variable","t":"$proxy"},{"k":"op","t":"."},{"k":"word","t":"BaseOperation"},{"k":"lparen","t":"("},{"k":"number","t":"42"},{"k":"rparen","t":")"},{"k":"pipe","t":"|"},{"k":"word","t":"Should"},{"k":"parameter","t":"-Be"},{"k":"string2",