# Oracle/parity/corpus fixtures are byte-exact test data paired with
# generated expectations; line-ending conversion on checkout (Windows
# autocrlf) would invalidate them. Never convert anything under tests/.
tests/** -text

# ── Linguist ────────────────────────────────────────────────────────────
# Without these the repo reads as a PowerShell project: the committed
# fixtures alone are ~100 .ps1/.json files, dwarfing the Rust that
# generates them.
# https://github.com/github-linguist/linguist/blob/HEAD/docs/overrides.md

# Generated: excluded from stats and collapsed in diffs. Regenerated by
# tests/**/generate*.ps1 and the schema binary; never hand-edited.
tests/powershell-oracle/fixtures/**       linguist-generated
tests/pssa-parity/expected/**             linguist-generated
tests/pssa-parity/catalog.json            linguist-generated
crates/dprint-plugin-pwsh/deployment/schema.json linguist-generated
crates/pwsh-formatter/tests/properties.proptest-regressions linguist-generated
packages/formatter/dist/**                linguist-generated

# Vendored: third-party PowerShell kept verbatim as formatting corpus.
tests/corpus/files/**                     linguist-vendored
tests/powershell-oracle/inputs/upstream-* linguist-vendored

# Documentation: prose, not project language.
docs/**                                   linguist-documentation
fuzz/README.md                            linguist-documentation
tests/corpus/README.md                    linguist-documentation
